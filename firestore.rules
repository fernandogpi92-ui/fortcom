rules_version = '2';

// FORTCOM — regras do novo projeto Firebase `fortcom-obras`.
//
// O app sincroniza o documento empresas/fortcom/dados/principal.
// Publique estas regras em Firestore Database → Rules → Publish somente
// depois de habilitar E-mail/senha e criar o usuário proprietário.
// Este arquivo no Git, sozinho, NÃO altera as regras publicadas no Firebase.
//
// O acesso é limitado à conta proprietária e ao único documento usado pelo app.
// Todo o restante permanece negado.
service cloud.firestore {
  match /databases/{database}/documents {
    function dono() {
      return request.auth != null
        && request.auth.token.email == 'fernandogpi92@gmail.com';
    }

    match /empresas/fortcom/dados/principal {
      allow read, write: if dono();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
